                           style="font-size:12px; color:#c0c0c0;"></i>
                    </div>
                    <div>
                        <h3 class="font-montserrat font-bold text-white text-sm"
                            x-text="modalMode === 'tambah' ? 'Tambah Produk Baru' : 'Edit Produk'"></h3>
                        <p class="text-xs mt-0.5" style="color:#444;"
                           x-text="modalMode === 'edit' ? 'SKU: ' + (editData.sku || '—') : 'Isi data produk dengan lengkap'"></p>
                    </div>
                </div>
                <button @click="closeModal()"
                        style="width:28px; height:28px; border-radius:6px; background:transparent; border:1px solid #222; color:#555; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.2s;"
                        onmouseover="this.style.borderColor='#555'; this.style.color='#ccc';"
                        onmouseout="this.style.borderColor='#222'; this.style.color='#555';">
                    <i class="fas fa-times" style="font-size:11px;"></i>
                </button>
            </div>

            {{-- Modal Body --}}
            <div class="modal-body" style="max-height:70vh; overflow-y:auto;">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5">

                    {{-- Nama Produk --}}
                    <div class="form-group sm:col-span-2">
                        <label class="form-label">Nama Produk <span>*</span></label>
                        <input type="text" class="form-input"
                               placeholder="Contoh: Pola Kemeja Pria Slim Fit"
                               :value="editData.nama || ''">
                    </div>

                    {{-- SKU --}}
                    <div class="form-group">
                        <label class="form-label">SKU / Kode Produk <span>*</span></label>
                        <input type="text" class="form-input"
                               placeholder="PKP-SLM-001"
                               :value="editData.sku || ''">
                    </div>

                    {{-- Kategori --}}
                    <div class="form-group">
                        <label class="form-label">Kategori <span>*</span></label>
                        <select class="form-input">
                            <option value="">Pilih kategori...</option>
                            @foreach(['Kemeja Pria','Kemeja Wanita','Gaun & Dress','Celana & Rok','Aksesoris'] as $k)
                            <option>{{ $k }}</option>
                            @endforeach
                        </select>
                    </div>

                    {{-- Tipe Produk --}}
                    <div class="form-group sm:col-span-2">
                        <label class="form-label">Tipe Produk <span>*</span></label>
                        <div class="flex gap-3">
                            <label class="radio-card" :class="tipe === 'fisik' ? 'selected' : ''"
                                   @click="tipe = 'fisik'">
                                <input type="radio" name="tipe" value="fisik" x-model="tipe">
                                <div style="width:32px; height:32px; border-radius:8px; background:#111; border:1px solid #222; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fas fa-box" style="color:#c084fc; font-size:13px;"></i>
                                </div>
                                <div>
                                    <div class="text-sm font-semibold text-white">Fisik</div>
                                    <div class="text-xs mt-0.5" style="color:#555;">Dikirim via kurir</div>
                                </div>
                            </label>
                            <label class="radio-card" :class="tipe === 'digital' ? 'selected' : ''"
                                   @click="tipe = 'digital'">
                                <input type="radio" name="tipe" value="digital" x-model="tipe">
                                <div style="width:32px; height:32px; border-radius:8px; background:#111; border:1px solid #222; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fas fa-file-pdf" style="color:#c0c0c0; font-size:13px;"></i>
                                </div>
                                <div>
                                    <div class="text-sm font-semibold text-white">Digital PDF</div>
                                    <div class="text-xs mt-0.5" style="color:#555;">Download otomatis</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    {{-- Harga --}}
                    <div class="form-group">
                        <label class="form-label">Harga (Rp) <span>*</span></label>
                        <div class="relative">
                            <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#444; font-size:12px;">Rp</span>
                            <input type="number" class="form-input" placeholder="75000"
                                   style="padding-left:36px;"
                                   :value="editData.harga || ''">
                        </div>
                    </div>

                    {{-- Stok (hanya fisik) --}}
                    <div class="form-group" x-show="tipe === 'fisik'">
                        <label class="form-label">Stok <span>*</span></label>
                        <input type="number" class="form-input" placeholder="0" min="0"
                               :value="editData.stok || 0">
                    </div>

                    {{-- Deskripsi --}}
                    <div class="form-group sm:col-span-2">
                        <label class="form-label">Deskripsi Produk</label>
                        <textarea class="form-input"
                                  placeholder="Deskripsi detail produk pola jahit, ukuran, bahan, dan instruksi pemakaian..."></textarea>
                    </div>

                    {{-- Upload Gambar --}}
                    <div class="form-group" :class="tipe === 'digital' ? '' : 'sm:col-span-2'">
                        <label class="form-label">Upload Gambar Produk</label>
                        <div class="upload-area" onclick="document.getElementById('uploadGambar').click()">
                            <i class="fas fa-image" style="color:#2a2a2a; font-size:24px; margin-bottom:8px; display:block;"></i>
                            <p class="text-xs" style="color:#444;">Drag & drop atau <span style="color:#c0c0c0; cursor:pointer;">klik untuk upload</span></p>
                            <p class="text-xs mt-1" style="color:#2a2a2a;">PNG, JPG, WEBP — Maks. 2MB</p>
                            <input type="file" id="uploadGambar" accept="image/*" style="display:none;">
                        </div>
                    </div>

                    {{-- Upload PDF (hanya digital) --}}
                    <div class="form-group" x-show="tipe === 'digital'">
                        <label class="form-label">Upload File PDF <span>*</span></label>
                        <div class="upload-area" onclick="document.getElementById('uploadPDF').click()">
                            <i class="fas fa-file-pdf" style="color:#2a2a2a; font-size:24px; margin-bottom:8px; display:block;"></i>
                            <p class="text-xs" style="color:#444;">Drag & drop atau <span style="color:#c0c0c0; cursor:pointer;">klik untuk upload</span></p>
                            <p class="text-xs mt-1" style="color:#2a2a2a;">PDF saja — Maks. 50MB</p>
                            <input type="file" id="uploadPDF" accept=".pdf" style="display:none;">
                        </div>
                    </div>

                    {{-- Status --}}
                    <div class="form-group sm:col-span-2">
                        <label class="form-label">Status Produk <span>*</span></label>
                        <div class="flex gap-3">
                            <label class="radio-card" :class="statusProduk === 'aktif' ? 'selected' : ''"
                                   @click="statusProduk = 'aktif'" style="flex:none; padding:8px 16px;">
                                <input type="radio" name="status" value="aktif" x-model="statusProduk">
                                <i class="fas fa-check-circle" style="color:#22c55e; font-size:13px;"></i>
                                <span class="text-sm font-semibold text-white">Aktif</span>
                            </label>
                            <label class="radio-card" :class="statusProduk === 'nonaktif' ? 'selected' : ''"
                                   @click="statusProduk = 'nonaktif'" style="flex:none; padding:8px 16px;">
                                <input type="radio" name="status" value="nonaktif" x-model="statusProduk">
                                <i class="fas fa-times-circle" style="color:#ef4444; font-size:13px;"></i>
                                <span class="text-sm font-semibold text-white">Nonaktif</span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>

            {{-- Modal Footer --}}
            <div class="modal-footer">
                <button @click="closeModal()" class="btn-admin-outline gap-2">
                    <i class="fas fa-times" style="font-size:10px;"></i> Batal
                </button>
                <button class="btn-admin-primary gap-2">
                    <i class="fas fa-save" style="font-size:11px;"></i>
                    <span x-text="modalMode === 'tambah' ? 'Simpan Produk' : 'Update Produk'"></span>
                </button>
            </div>

        </div>
    </div>{{-- end modal --}}

</div>{{-- end x-data --}}
@endsection
