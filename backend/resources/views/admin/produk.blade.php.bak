{{-- Alpine.js state untuk seluruh halaman --}}
<div x-data="{
    showModal: false,
    modalMode: 'tambah',
    editData: {},
    selected: [],
    selectAll: false,
    tipe: 'fisik',
    statusProduk: 'aktif',

    openTambah() {
        this.modalMode = 'tambah';
        this.tipe = 'fisik';
        this.statusProduk = 'aktif';
        this.editData = {};
        this.showModal = true;
    },
    openEdit(data) {
        this.modalMode = 'edit';
        this.editData = data;
        this.tipe = data.tipe;
        this.statusProduk = data.status;
        this.showModal = true;
    },
    closeModal() { this.showModal = false; },
    toggleAll() {
        if (this.selectAll) {
            this.selected = @json(array_column($produk, 'id'));
        } else {
            this.selected = [];
        }
    },
}">

