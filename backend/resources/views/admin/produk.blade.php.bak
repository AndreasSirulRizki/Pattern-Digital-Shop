<style>
    /* ── Kelola Produk ── */

    /* Filter bar */
    .filter-input {
        background: #0f0f0f;
        border: 1px solid #1e1e1e;
        border-radius: 8px;
        color: #fff;
        font-size: 12px;
        font-family: 'Inter', sans-serif;
        padding: 8px 12px;
        outline: none;
        transition: border-color 0.2s;
    }
    .filter-input:focus { border-color: #333; }
    .filter-input::placeholder { color: #2a2a2a; }
    select.filter-input { cursor: pointer; }
    select.filter-input option { background: #1a1a1a; }

    /* Table */
    .prod-table { width: 100%; border-collapse: collapse; }
    .prod-table th {
        text-align: left;
        padding: 10px 14px;
        font-size: 10px; font-weight: 700;
        color: #3a3a3a;
        letter-spacing: 0.08em; text-transform: uppercase;
        border-bottom: 1px solid #1a1a1a;
        background: #0f0f0f;
        white-space: nowrap;
    }
    .prod-table td {
        padding: 11px 14px;
        font-size: 12px;
        border-bottom: 1px solid #111;
        vertical-align: middle;
    }
    .prod-table tr:last-child td { border-bottom: none; }
    .prod-table tbody tr:hover td {
        background: rgba(192,192,192,0.02);
    }

    /* Custom checkbox */
    .tbl-check {
        width: 15px; height: 15px;
        accent-color: #c0c0c0;
        cursor: pointer;
    }

    /* Prod thumb */
    .prod-thumb-sm {
        width: 48px; height: 48px;
        border-radius: 8px;
        background: #111;
        border: 1px solid #1e1e1e;
        overflow: hidden;
        flex-shrink: 0;
    }
    .prod-thumb-sm img { width: 100%; height: 100%; object-fit: cover; }

    /* Badges */
    .badge {
        display: inline-flex; align-items: center; gap: 3px;
        padding: 3px 8px; border-radius: 10px;
        font-size: 10px; font-weight: 700;
        letter-spacing: 0.03em; white-space: nowrap;
    }
    .badge-fisik    { background: rgba(168,85,247,0.1);  border:1px solid rgba(168,85,247,0.25); color: #c084fc; }
    .badge-digital  { background: rgba(192,192,192,0.1); border:1px solid rgba(192,192,192,0.25); color: #c0c0c0; }
    .badge-aktif    { background: rgba(34,197,94,0.1);   border:1px solid rgba(34,197,94,0.25);  color: #22c55e; }
    .badge-nonaktif { background: rgba(239,68,68,0.1);   border:1px solid rgba(239,68,68,0.25);  color: #ef4444; }

    /* Stock warning */
    .stok-low { color: #ef4444; font-weight: 700; }
    .stok-ok  { color: #888; }

    /* Action buttons */
    .tbl-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 5px 10px; border-radius: 6px;
        font-size: 11px; font-weight: 500;
        cursor: pointer; transition: all 0.2s;
        text-decoration: none; white-space: nowrap;
        font-family: 'Inter', sans-serif;
    }
    .tbl-btn-edit {
        background: rgba(192,192,192,0.06);
        border: 1px solid rgba(192,192,192,0.2);
        color: #c0c0c0;
    }
    .tbl-btn-edit:hover { background: rgba(192,192,192,0.12); border-color: #c0c0c0; }
    .tbl-btn-del {
        background: rgba(239,68,68,0.06);
        border: 1px solid rgba(239,68,68,0.2);
        color: #ef4444;
    }
    .tbl-btn-del:hover { background: rgba(239,68,68,0.14); border-color: #ef4444; }

    /* Bulk action bar */
    .bulk-bar {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 16px; border-radius: 8px;
        background: rgba(192,192,192,0.05);
        border: 1px solid rgba(192,192,192,0.15);
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    /* Modal */
    .modal-overlay {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(4px);
        z-index: 200;
        display: flex; align-items: flex-start; justify-content: center;
        padding: 24px 16px;
        overflow-y: auto;
    }
    .modal-card {
        background: linear-gradient(145deg, #1a1a1a, #161616);
        border: 1px solid #c0c0c0;
        border-radius: 14px;
        width: 100%; max-width: 680px;
        box-shadow: 0 0 60px rgba(0,0,0,0.8), 0 0 30px rgba(192,192,192,0.06);
        overflow: hidden;
        flex-shrink: 0;
    }
    .modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 18px 22px;
        border-bottom: 1px solid #222;
        background: linear-gradient(135deg, #1e1e1e, #181818);
    }
    .modal-body { padding: 22px; }
    .modal-footer {
        padding: 16px 22px;
        border-top: 1px solid #1e1e1e;
        display: flex; justify-content: flex-end; gap: 10px;
        background: #111;
    }

    /* Form elements */
    .form-group { margin-bottom: 16px; }
    .form-label {
        display: block; font-size: 11px; font-weight: 600;
        color: #666; margin-bottom: 6px;
        letter-spacing: 0.04em; text-transform: uppercase;
    }
    .form-label span { color: #ef4444; }

    .form-input {
        width: 100%;
        background: #0f0f0f;
        border: 1px solid #222;
        border-radius: 8px;
        color: #fff; font-size: 13px;
        font-family: 'Inter', sans-serif;
        padding: 9px 13px;
        outline: none; transition: border-color 0.2s;
    }
    .form-input:focus { border-color: #555; box-shadow: 0 0 0 2px rgba(192,192,192,0.06); }
    .form-input::placeholder { color: #2a2a2a; }
    select.form-input { cursor: pointer; }
    select.form-input option { background: #1a1a1a; }
    textarea.form-input { resize: vertical; min-height: 80px; }

    /* Radio card */
    .radio-card {
        border: 1px solid #222; border-radius: 8px;
        padding: 10px 14px; cursor: pointer;
        transition: all 0.2s; background: #0f0f0f;
        display: flex; align-items: center; gap: 10px;
        flex: 1;
    }
    .radio-card:hover { border-color: #333; }
    .radio-card.selected {
        border-color: #c0c0c0;
        background: linear-gradient(135deg, #1e1e1e, #161616);
        box-shadow: 0 0 10px rgba(192,192,192,0.06);
    }
    .radio-card input[type="radio"] { display: none; }

    /* Upload area */
    .upload-area {
        border: 1px dashed #2a2a2a;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        background: #0a0a0a;
    }
    .upload-area:hover { border-color: #555; background: #0f0f0f; }

    /* Pagination */
    .page-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px;
        border-radius: 6px; font-size: 11px; font-weight: 600;
        cursor: pointer; transition: all 0.15s;
        border: 1px solid #1a1a1a; color: #555;
        background: transparent; font-family: 'Inter', sans-serif;
    }
    .page-btn:hover { border-color: #333; color: #888; }
    .page-btn.active {
        background: linear-gradient(135deg, #222, #181818);
        border-color: rgba(192,192,192,0.3); color: #c0c0c0;
    }

    /* Scrollable table wrapper */
    .table-wrap { overflow-x: auto; }
    .table-wrap::-webkit-scrollbar { height: 3px; }
    .table-wrap::-webkit-scrollbar-thumb { background: #1e1e1e; border-radius: 2px; }
</style>
